{
  "name": "angular-rspack",
  "version": "0.0.0",
  "description": "Rspack plugin and Angular compiler utilities without Nx runtime dependencies.",
  "type": "commonjs",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    },
    "./loaders/angular-partial-transform-loader": {
      "types": "./dist/lib/plugins/loaders/angular-partial-transform.loader.d.ts",
      "default": "./dist/lib/plugins/loaders/angular-partial-transform.loader.js"
    },
    "./loaders/angular-loader": {
      "types": "./dist/lib/plugins/loaders/angular-transform.loader.d.ts",
      "default": "./dist/lib/plugins/loaders/angular-transform.loader.js"
    },
    "./loaders/platform-server-exports-loader": {
      "types": "./dist/lib/plugins/loaders/platform-server-exports.loader.d.ts",
      "default": "./dist/lib/plugins/loaders/platform-server-exports.loader.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "patch",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "rstest run",
    "lint": "rslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "node ./patch/patch-angular-build.js"
  },
  "keywords": [
    "Angular",
    "Rspack"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.33.1",
  "dependencies": {
    "@ampproject/remapping": "2.3.0",
    "@angular/build": ">=19.0.0 <22.0.0",
    "@babel/core": "^7.23.2",
    "@discoveryjs/json-ext": "^1.1.0",
    "@rspack/core": ">=1.3.5 <1.7.0",
    "ansi-colors": "4.1.3",
    "autoprefixer": "^10.4.9",
    "css-loader": "^7.1.2",
    "deepmerge": "^4.3.1",
    "jsonc-parser": "^3.2.0",
    "less-loader": "^12.2.0",
    "license-webpack-plugin": "^4.0.2",
    "loader-utils": "3.3.1",
    "open": "10.1.0",
    "ora": "^5.3.0",
    "parse5-html-rewriting-stream": "7.0.0",
    "piscina": "5.0.0",
    "postcss": "^8.4.38",
    "postcss-loader": "^8.1.1",
    "resolve-url-loader": "^5.0.0",
    "rxjs": "^6.5.3 || ^7.5.0",
    "sass": "^1.97.2",
    "sass-embedded": "^1.97.2",
    "sass-loader": "^16.0.7",
    "semver": "^7.6.3",
    "source-map-loader": "^5.0.0",
    "ts-morph": "^27.0.2",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "webpack-merge": "^6.0.1",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@angular/compiler-cli": ">=19.0.0 <22.0.0",
    "@angular/core": ">=19.0.0 <22.0.0",
    "@angular/localize": ">=19.0.0 <22.0.0",
    "@angular/platform-server": ">=19.0.0 <22.0.0",
    "@angular/ssr": ">=19.0.0 <22.0.0",
    "@rsbuild/core": ">=1.0.5 <3.0.0",
    "tailwindcss": "^2.0.0 || ^3.0.0 || ^4.0.0",
    "zone.js": "~0.15.0 || ~0.16.0"
  },
  "peerDependenciesMeta": {
    "@angular/localize": {
      "optional": true
    },
    "@angular/platform-server": {
      "optional": true
    },
    "@angular/ssr": {
      "optional": true
    },
    "@rsbuild/core": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "zone.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rslint/core": "^0.5.3",
    "@rstest/core": "^0.10.2",
    "@types/babel__core": "^7.20.5",
    "@types/loader-utils": "^3.0.0",
    "@types/node": "^24.11.0",
    "@types/ws": "^8.18.1"
  }
}
