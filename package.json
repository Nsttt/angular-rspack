{
  "name": "angular-rspack",
  "version": "1.0.1",
  "description": "Standalone Rspack plugin and Angular compiler utilities.",
  "type": "commonjs",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./rspack": {
      "types": "./dist/lib/rspack.d.ts",
      "default": "./dist/lib/rspack.js"
    },
    "./rsbuild": {
      "types": "./dist/lib/rsbuild.d.ts",
      "default": "./dist/lib/rsbuild.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    },
    "./loaders/angular-partial-transform-loader": {
      "types": "./dist/lib/plugins/loaders/angular-partial-transform.loader.d.ts",
      "default": "./dist/lib/plugins/loaders/angular-partial-transform.loader.js"
    },
    "./loaders/angular-loader": {
      "types": "./dist/lib/plugins/loaders/angular-transform.loader.d.ts",
      "default": "./dist/lib/plugins/loaders/angular-transform.loader.js"
    },
    "./loaders/platform-server-exports-loader": {
      "types": "./dist/lib/plugins/loaders/platform-server-exports.loader.d.ts",
      "default": "./dist/lib/plugins/loaders/platform-server-exports.loader.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "patch",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc -p tsconfig.lib.json",
    "build:example:rspack": "pnpm --filter angular-rspack-rspack-example build",
    "build:example:rsbuild": "pnpm --filter angular-rspack-rsbuild-example build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:dry-run": "pnpm stage publish --dry-run --access public --tag ${NPM_TAG:-latest}",
    "release:stage": "pnpm stage publish --access public --tag ${NPM_TAG:-latest}",
    "test": "rstest run",
    "lint": "rslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "node ./patch/patch-angular-build.js"
  },
  "keywords": [
    "Angular",
    "Rspack"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nsttt/angular-rspack.git"
  },
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "@ampproject/remapping": "2.3.0",
    "@angular/build": "^21.2.12",
    "@babel/core": "^7.29.0",
    "@discoveryjs/json-ext": "^1.1.0",
    "@rspack/core": "^2.0.4",
    "ansi-colors": "4.1.3",
    "autoprefixer": "^10.4.9",
    "css-loader": "^7.1.2",
    "deepmerge": "^4.3.1",
    "jsonc-parser": "^3.2.0",
    "less-loader": "^13.0.0",
    "license-webpack-plugin": "^4.0.2",
    "loader-utils": "3.3.1",
    "open": "^11.0.0",
    "ora": "^9.4.0",
    "parse5-html-rewriting-stream": "^8.0.1",
    "piscina": "^5.1.4",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.2.1",
    "resolve-url-loader": "^5.0.0",
    "rxjs": "^6.5.3 || ^7.5.0",
    "sass": "^1.97.2",
    "sass-embedded": "^1.97.2",
    "sass-loader": "^17.0.0",
    "semver": "^7.6.3",
    "source-map-loader": "^5.0.0",
    "ts-morph": "^28.0.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.3",
    "webpack-merge": "^6.0.1",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@angular/compiler-cli": "^21.2.14",
    "@angular/core": "^21.2.14",
    "@angular/localize": "^21.2.14",
    "@angular/platform-server": "^21.2.14",
    "@angular/ssr": "^21.2.12",
    "@rsbuild/core": "^2.0.7",
    "tailwindcss": "^2.0.0 || ^3.0.0 || ^4.0.0",
    "zone.js": "~0.15.0 || ~0.16.0"
  },
  "peerDependenciesMeta": {
    "@angular/localize": {
      "optional": true
    },
    "@angular/platform-server": {
      "optional": true
    },
    "@angular/ssr": {
      "optional": true
    },
    "@rsbuild/core": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "zone.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@rsbuild/core": "^2.0.7",
    "@rslint/core": "^0.5.3",
    "@rstest/core": "^0.10.2",
    "@types/babel__core": "^7.20.5",
    "@types/loader-utils": "^3.0.0",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "rimraf": "^6.1.3"
  }
}
